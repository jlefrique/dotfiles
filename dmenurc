# Customize dmenu appearance.

BIN="/usr/bin/dmenu -i"
# Carbonfox: background and text as in xmobar, selection in the active workspace cyan.
COLOR="-nb #161616 -nf #b6b8bb -sb #33b1ff -sf #161616"

VERSION=$(/usr/bin/dmenu -v | sed -e 's/dmenu-\([0-9]\.[0-9]\).*/\1/')

# Starting from version 4.6, dmenu uses Xft fonts
if [ $(echo "${VERSION} >= 4.6" | bc) -eq 0 ]; then
    FONT="-fn -*-terminus-*-*-*-*-12-*-*-*-*-*-*-*"
else
    # No spaces in the name: DMENU is word-split; fontconfig ignores them anyway.
    FONT="-fn TerminessNerdFont:pixelsize=14"
fi


DMENU="$BIN $COLOR $FONT"
