Config { font = "xft:Terminess Nerd Font:pixelsize=12"
       , bgColor = "#161616"
       , fgColor = "#b6b8bb"
       , position = TopSize L 90 16
       , lowerOnStart = True
       , commands = [ Run Weather "LSGG" ["-t","󰖕  <skyCondition> <tempC>C","-L","18","-H","25","--normal","#25be6a","--high","#ee5396","--low","#78a9ff"] 36000
                    , Run DynNetwork ["-t","󰛳  <dev> <rx>KB|<tx>KB","-m","4","-a","l","-L","0","-H","32","--normal","#25be6a","--high","#ee5396"] 10
                    , Run Cpu ["-t","󰓅  <total>%","-p","3","-L","3","-H","50","--normal","#25be6a","--high","#ee5396"] 10
                    , Run Memory ["-t","󰍛  <usedratio>%","-p","3"] 10
                    , Run Com "sh" ["-c","df -BG --output=avail,size / | awk 'NR==2 { sub(/G/, \"\", $1); sub(/G/, \"\", $2); print \"󰋊  \" $1 \"/\" $2 \" G\" }'"] "disk" 600
                    , Run Com "xmobar_battery.sh" [] "battery" 600
                    --, Run Com "/bin/bash" ["-c","~/dotfiles/bin/quotes.sh -s \" * \""] "quotes" 600
                    , Run Date "󰃭  %a %b %_d %Y %H:%M:%S" "date" 10
                    , Run Com "sh" ["-c","echo \"󰇧  $(TZ=America/Los_Angeles date +'%Z %H:%M')  $(TZ=America/New_York date +'%Z %H:%M')\""] "usclocks" 300
                    , Run Kbd [("us", "󰌌  US"), ("dvorak", "󰌌  DV"), ("us(dvorak)", "󰌌  DV")]
                    , Run StdinReader
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "%StdinReader% }{ %cpu% | %memory% | %disk% | %battery% | %dynnetwork% | %kbd% | <fc=#f1c21b>%date%</fc> | %usclocks% | %LSGG%"
       }
