Config { font = "xft:Terminess Nerd Font:pixelsize=12"
       , bgColor = "#161616"
       , fgColor = "#b6b8bb"
       , position = TopSize L 90 16
       , lowerOnStart = True
       , commands = [ Run Weather "LSGG" ["-t","󰖕  <tempC>C","-L","18","-H","25","--normal","#25be6a","--high","#ee5396","--low","#78a9ff"] 36000
                    , Run Network "eth0" ["-L","0","-H","32","--normal","#25be6a","--high","#ee5396"] 10
                    , Run Cpu ["-t","󰓅  <total>%","-p","3","-L","3","-H","50","--normal","#25be6a","--high","#ee5396"] 10
                    , Run Memory ["-t","󰍛  <usedratio>%","-p","3"] 10
                    , Run DiskU [("/", "Disk: <free> free")] ["-L", "10", "--low", "#ee5396"] 600
                    , Run Battery [ "-t", "Batt: <left>%"
                                  , "-L", "10", "-H", "80", "-p", "3"
                                  , "--", "-O", "<fc=#25be6a>On</fc> - ", "-i", ""
                                  , "-L", "-15", "-H", "-5"
                                  , "-l", "#ee5396", "-m", "#78a9ff", "-h", "#25be6a"
                                  ] 600
                    --, Run Com "/bin/bash" ["-c","~/dotfiles/bin/quotes.sh -s \" * \""] "quotes" 600
                    , Run Date "󰃭  %a %b %_d %Y %H:%M:%S" "date" 10
                    , Run StdinReader
                    ]
       , sepChar = "%"
       , alignSep = "}{"
       , template = "%StdinReader% }{ %cpu% | %memory% | %disku% | %battery% | %eth0% | <fc=#f1c21b>%date%</fc> | %LSGG%"
       }
